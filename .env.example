# TEN Capital Investor Matching Engine - environment configuration
# Copy to .env and adjust. Never commit a real .env file.

# --- External model (optional) ----------------------------------------------
# The engine is fully functional without an LLM: extraction, scoring, ranking and
# the report are deterministic. When enabled, deck text is SENT TO ANTHROPIC'S API
# for field extraction and wording polish.
TEN_LLM_ENABLED=false
ANTHROPIC_API_KEY=
TEN_LLM_MODEL=claude-opus-5
TEN_LLM_TIMEOUT_SECONDS=300

# --- Automated results email (Resend) -----------------------------------------------
# Each generated report is emailed (summary + PDF + JSON record attached) to TEN_NOTIFY_TO.
# Recipients come only from here, never from the UI. TEN_NOTIFY_FROM must be on a domain verified in Resend.
TEN_NOTIFY_ENABLED=false
RESEND_API_KEY=
TEN_NOTIFY_TO=Info@tencapital.group
TEN_NOTIFY_FROM=TEN Capital Investor Matching <reports@tencapital.group>
TEN_NOTIFY_REPLY_TO=

# --- Web access --------------------------------------------------------------------
# Required for any public deployment: the app spends your API credits and handles
# confidential decks. Leave empty only for local use.
TEN_APP_PASSWORD=

# --- Investor data -------------------------------------------------------------
# Semicolon-separated list of CSV/JSON investor datasets loaded by default.
# The bundled dataset is SYNTHETIC (fictitious firms) and is for testing only.
TEN_INVESTOR_DATA_PATHS=sample_data/investors_synthetic.json

# --- Investor database (Postgres) ----------------------------------------------
# Connection string for the InvestorMatch database (schema "im"). When set, its investors
# load with the datasets above. On Railway, set DATABASE_URL=${{Postgres.DATABASE_URL}} on
# this service, and set TEN_INVESTOR_DATA_PATHS to empty to stop loading the synthetic file.
DATABASE_URL=

# --- Uploads, output and logging ------------------------------------------------
TEN_MAX_UPLOAD_MB=50
TEN_OUTPUT_DIR=output
TEN_WEIGHTS_FILE=config/matching.toml
TEN_LOG_LEVEL=INFO

# --- Report ------------------------------------------------------------------------
TEN_REPORT_ORGANIZATION=TEN Capital Network
